# Carpetas de comprobantes/PDFs generados en runtime (no son codigo fuente)
/archivos/
/archivos1/
/archivos_2/
/temp/

# Basura de sistema
.DS_Store
Thumbs.db

# Dump de produccion de Renacer (contiene hashes de claves): no versionar
/sql/admin_renacer.sql

# Configuracion local generada por el instalador (credenciales)
/config/config.php
/config/instalado.lock

# Logo y archivos subidos por el usuario
/assets/uploads/*
!/assets/uploads/.gitkeep
!/assets/uploads/.htaccess
